#!/usr/bin/env bash
# ────────────────────────────────────────────────────────────────────
# ZeroClaw HA Add-on — run script (Python)
#
# Reads /data/options.json and passes config via environment
# variables to the Python server.
# ────────────────────────────────────────────────────────────────────

set -euo pipefail

OPTIONS_FILE="/data/options.json"

if [ ! -f "${OPTIONS_FILE}" ]; then
    echo "[zeroclaw] ERROR: /data/options.json not found"
    exit 1
fi

# Export all config as environment variables for server.py
export ZEROCLAW_OPTIONS_FILE="${OPTIONS_FILE}"
export ZEROCLAW_PROVIDER=$(jq -r '.provider // "ollama"' "${OPTIONS_FILE}")
export ZEROCLAW_MODEL=$(jq -r '.model // ""' "${OPTIONS_FILE}")
export ZEROCLAW_API_KEY=$(jq -r '.api_key // ""' "${OPTIONS_FILE}")
export ZEROCLAW_API_URL=$(jq -r '.api_url // "http://homeassistant:11434"' "${OPTIONS_FILE}")
export ZEROCLAW_TEMPERATURE=$(jq -r '.temperature // 0.7' "${OPTIONS_FILE}")
export ZEROCLAW_SYSTEM_PROMPT=$(jq -r '.system_prompt // ""' "${OPTIONS_FILE}")
export ZEROCLAW_EVENT_LISTENER=$(jq -r '.event_listener // true' "${OPTIONS_FILE}")
export ZEROCLAW_LOG_LEVEL=$(jq -r '.log_level // "info"' "${OPTIONS_FILE}")
export ZEROCLAW_MQTT_ENABLED=$(jq -r '.mqtt_enabled // false' "${OPTIONS_FILE}")
export ZEROCLAW_MQTT_BROKER=$(jq -r '.mqtt_broker // "core-mosquitto"' "${OPTIONS_FILE}")
export ZEROCLAW_MQTT_PORT=$(jq -r '.mqtt_port // 1883' "${OPTIONS_FILE}")
export ZEROCLAW_MQTT_USERNAME=$(jq -r '.mqtt_username // ""' "${OPTIONS_FILE}")
export ZEROCLAW_MQTT_PASSWORD=$(jq -r '.mqtt_password // ""' "${OPTIONS_FILE}")
export ZEROCLAW_ALLOWED_DOMAINS=$(jq -c '.allowed_domains // []' "${OPTIONS_FILE}")
export ZEROCLAW_EVENT_FILTER=$(jq -c '.event_filter // ["state_changed"]' "${OPTIONS_FILE}")

# SUPERVISOR_TOKEN is automatically injected by HA Supervisor
echo "[zeroclaw] Starting ZeroClaw AI Agent (Python)..."
echo "[zeroclaw]   Provider: ${ZEROCLAW_PROVIDER}"
echo "[zeroclaw]   Model: ${ZEROCLAW_MODEL:-auto}"
echo "[zeroclaw]   HA Integration: enabled"
echo "[zeroclaw]   Event Listener: ${ZEROCLAW_EVENT_LISTENER}"

exec python3 /app/server.py
