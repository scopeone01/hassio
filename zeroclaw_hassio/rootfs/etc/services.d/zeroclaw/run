#!/usr/bin/with-contenv bashio
# ────────────────────────────────────────────────────────────────────
# ZeroClaw HA Add-on — s6-overlay run script
#
# Reads /data/options.json (populated by HA Supervisor from the
# add-on config UI) and maps it to ZeroClaw environment variables
# and config.toml, then starts `zeroclaw daemon`.
# ────────────────────────────────────────────────────────────────────

set -euo pipefail

CONFIG_DIR="/data/zeroclaw"
CONFIG_FILE="${CONFIG_DIR}/config.toml"

mkdir -p "${CONFIG_DIR}"
mkdir -p "${CONFIG_DIR}/workspace"

# ── Read add-on options ─────────────────────────────────────────────

PROVIDER=$(bashio::config 'provider')
MODEL=$(bashio::config 'model')
API_KEY=$(bashio::config 'api_key')
API_URL=$(bashio::config 'api_url')
TEMPERATURE=$(bashio::config 'temperature')
SYSTEM_PROMPT=$(bashio::config 'system_prompt')
EVENT_LISTENER=$(bashio::config 'event_listener')
MQTT_ENABLED=$(bashio::config 'mqtt_enabled')
MQTT_BROKER=$(bashio::config 'mqtt_broker')
MQTT_PORT=$(bashio::config 'mqtt_port')
MQTT_USERNAME=$(bashio::config 'mqtt_username')
MQTT_PASSWORD=$(bashio::config 'mqtt_password')
LOG_LEVEL=$(bashio::config 'log_level')

# Read allowed domains array
ALLOWED_DOMAINS=""
for domain in $(bashio::config 'allowed_domains'); do
    if [ -n "${ALLOWED_DOMAINS}" ]; then
        ALLOWED_DOMAINS="${ALLOWED_DOMAINS}, \"${domain}\""
    else
        ALLOWED_DOMAINS="\"${domain}\""
    fi
done

# Read event filter array
EVENT_FILTER=""
for evt in $(bashio::config 'event_filter'); do
    if [ -n "${EVENT_FILTER}" ]; then
        EVENT_FILTER="${EVENT_FILTER}, \"${evt}\""
    else
        EVENT_FILTER="\"${evt}\""
    fi
done

# ── Generate config.toml ───────────────────────────────────────────

cat > "${CONFIG_FILE}" <<EOF
# Auto-generated by ZeroClaw HA Add-on — do not edit manually
# Changes made here will be overwritten on restart.
# Use the HA Add-on configuration UI instead.

default_provider = "${PROVIDER}"
EOF

if [ -n "${MODEL}" ]; then
    echo "default_model = \"${MODEL}\"" >> "${CONFIG_FILE}"
fi

if [ -n "${API_KEY}" ]; then
    echo "api_key = \"${API_KEY}\"" >> "${CONFIG_FILE}"
fi

if [ -n "${API_URL}" ]; then
    echo "api_url = \"${API_URL}\"" >> "${CONFIG_FILE}"
fi

cat >> "${CONFIG_FILE}" <<EOF
default_temperature = ${TEMPERATURE}

[gateway]
host = "0.0.0.0"
port = 3000
require_pairing = false
allow_public_bind = true

[homeassistant]
enabled = true
supervisor_url = "http://supervisor"
auto_discover = true
allowed_domains = [${ALLOWED_DOMAINS}]
event_listener_enabled = ${EVENT_LISTENER}
event_filter = [${EVENT_FILTER}]

[homeassistant.mqtt]
enabled = ${MQTT_ENABLED}
broker = "${MQTT_BROKER}"
port = ${MQTT_PORT}
EOF

if [ -n "${MQTT_USERNAME}" ]; then
    echo "username = \"${MQTT_USERNAME}\"" >> "${CONFIG_FILE}"
fi
if [ -n "${MQTT_PASSWORD}" ]; then
    echo "password = \"${MQTT_PASSWORD}\"" >> "${CONFIG_FILE}"
fi

cat >> "${CONFIG_FILE}" <<EOF

[memory]
backend = "sqlite"
auto_save = true

[autonomy]
level = "full"
EOF

# ── Set environment variables ───────────────────────────────────────

export ZEROCLAW_WORKSPACE="${CONFIG_DIR}/workspace"
export ZEROCLAW_CONFIG="${CONFIG_FILE}"
export RUST_LOG="${LOG_LEVEL}"

# SUPERVISOR_TOKEN is automatically injected by HA Supervisor
# when hassio_api: true is set in config.yaml

bashio::log.info "Starting ZeroClaw AI Agent..."
bashio::log.info "  Provider: ${PROVIDER}"
bashio::log.info "  Model: ${MODEL:-auto}"
bashio::log.info "  HA Integration: enabled"
bashio::log.info "  Event Listener: ${EVENT_LISTENER}"
bashio::log.info "  MQTT: ${MQTT_ENABLED}"

# ── Start ZeroClaw daemon ──────────────────────────────────────────

exec zeroclaw daemon --host 0.0.0.0 --port 3000
