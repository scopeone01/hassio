#!/usr/bin/with-contenv bashio
# ────────────────────────────────────────────────────────────────────
# ZeroClaw HA Add-on — s6-overlay finish script
# Called when the zeroclaw process exits.
# ────────────────────────────────────────────────────────────────────

declare exit_code=${1}

if [ "${exit_code}" -ne 0 ] && [ "${exit_code}" -ne 256 ]; then
    bashio::log.warning "ZeroClaw exited with code ${exit_code} — restarting..."
fi
